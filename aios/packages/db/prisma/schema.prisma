// ---------------------------------------------------------------------------
// FOUNDATION — AUTH, TENANCY, ROLES
// ---------------------------------------------------------------------------

model Institute {
  id              String          @id @default(cuid())
  shortCode       String?         @unique // Unique readable short identifier (e.g. "SPFD") for QR payloads and booklet roll codes
  name            String
  domainAllowlist String[]        // list of allowed email domains/emails
  plan            InstitutePlan   @default(TRIAL)
  status          InstituteStatus @default(ONBOARDING)
  logoUrl         String?
  address         String?
  phone           String?
  featureFlags    Json            @default("{}") // 05-API-SPECIFICATION.md: PATCH /founder/feature-flags — per-tenant toggles (e.g. omrCapture, aiBlueprintAgent)
  trialEndsAt     DateTime?       // Founder Console Phase 2 — set when plan moves to TRIAL, cleared otherwise
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branches        Branch[]
  users           User[]
  batches         Batch[]
  subjects        Subject[]
  timetableSlots  TimetableSlot[]
  exams           Exam[]
  questions       Question[]
  papers          Paper[]
  blueprints      Blueprint[]
  notices         Notice[]
  reports         Report[]
  auditLogs       AuditLog[]
  interventions   Intervention[]
  allowListEntries AllowListEntry[]
  questionFamilies QuestionFamily[]

  // 21-DOMAIN-MODEL-V2.md / 04-DATABASE-SCHEMA.md (V2 section) — additive only,
  // Phase 7 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md): net-new tables, no v1
  // table touched.
  assessments        Assessment[]
  captureProviders   CaptureProvider[]
  rubrics            Rubric[]
  evaluationPolicies EvaluationPolicy[]

  // Founder Console build-out (see docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md,
  // "Founder Console — remaining screens") — additive only, no v1 table touched.
  planHistory      InstitutePlanHistory[]
  supportTickets   SupportTicket[]

  // Attendance V4
  attendanceSessions       AttendanceSession[]
  attendanceCorrectionLogs AttendanceCorrectionLog[]
  timetableExceptions      TimetableException[]

  // V2 Digital Examination Pipeline, Copy Checker Allocations, & Booklet Infrastructure
  batchEnrollments         BatchEnrollment[]
  copyCheckerAssignments   CopyCheckerAssignment[]
  bookletPrintRuns         BookletPrintRun[]
  booklets                 Booklet[]

  @@map("institutes")
}

/// Founder Console Phase 2 (Subscription/Plan management). Per-plan limits are
/// advisory/informational — surfaced as usage-vs-limit on the Founder dashboard.
/// Write-time enforcement (e.g. blocking a new user past maxUsers) is a
/// deliberately separate, not-yet-built concern; this table exists so the
/// dashboard shows real limits instead of inventing them.
model PlanDefinition {
  plan                   InstitutePlan @id
  maxUsers               Int?
  maxStudents            Int?
  maxTeachers            Int?
  maxStorageGb           Int?
  maxAssessmentsPerMonth Int?
  trialDurationDays      Int?
  defaultFeatureFlags    Json          @default("{}")
  updatedAt              DateTime      @updatedAt

  @@map("plan_definitions")
}

/// Generic platform-wide key/value settings store for the Founder Settings
/// screen. Deliberately minimal: this closes the "Save Changes claims success
/// but persists nothing" trust gap (audit-flagged Critical) by giving the
/// screen's toggle switches somewhere real to land. It does NOT imply every
/// setting exercised through here actually gates real behavior elsewhere —
/// most of the 25-tab screen's fields describe subsystems (billing, SSO/SAML,
/// IP whitelisting enforcement, LLM provider selection, etc.) that don't exist
/// anywhere else in this codebase yet, matching this project's established
/// "don't fabricate a backend for a UI that has nowhere real to plug in"
/// discipline. Only `maintenanceMode` is wired to real enforcement so far
/// (see MaintenanceGuard). One row per logical settings group, not one row
/// per field, so unrelated tabs can't clobber each other on save.
model PlatformSetting {
  key             String   @id
  value           Json
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("platform_settings")
}

/// Founder Console Phase 2 — append-only audit trail of plan changes,
/// separate from the generic AuditLog so plan history can be queried and
/// rendered as a timeline without parsing AuditLog's generic old/new JSON.
model InstitutePlanHistory {
  id              String         @id @default(cuid())
  instituteId     String
  institute       Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  fromPlan        InstitutePlan?
  toPlan          InstitutePlan
  changedByUserId String
  reason          String?
  createdAt       DateTime       @default(now())

  @@index([instituteId, createdAt])
  @@map("institute_plan_history")
}

/// Founder Console Phase 8 — a genuinely new subsystem (no prior backend
/// existed for this, only a mock UI). ADMIN creates/replies within their own
/// institute; FOUNDER has cross-tenant status/priority/assignment control.
model SupportTicket {
  id               String                 @id @default(cuid())
  instituteId      String
  institute        Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subject          String
  description      String
  status           SupportTicketStatus    @default(OPEN)
  priority         SupportTicketPriority  @default(MEDIUM)
  createdByUserId  String
  assignedToUserId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  resolvedAt       DateTime?

  messages SupportTicketMessage[]

  @@index([instituteId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model Branch {
  id          String    @id @default(cuid())
  instituteId String
  name        String
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batches     Batch[]

  @@map("branches")
}

/// Pre-approved email-to-role mapping for each institute.
/// This is what controls who can log in and as which role.
model AllowListEntry {
  id          String    @id @default(cuid())
  instituteId String
  email       String
  role        UserRole
  addedByUserId String?
  createdAt   DateTime  @default(now())

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, email])
  @@map("allow_list_entries")
}

model User {
  id          String     @id @default(cuid())
  instituteId String
  googleSub   String?    // Google's stable subject identifier (nullable for unlinked accounts)
  email       String
  name        String
  avatarUrl   String?
  role        UserRole
  status      UserStatus @default(ACTIVE)
  tokenVersion Int       @default(0) // Founder Console Phase 4 — bumped to force-invalidate every issued JWT for this user
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  institute          Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacherProfile     TeacherProfile?
  studentProfile     StudentProfile?
  auditLogsAsActor   AuditLog[]       @relation("AuditActor")
  assignedDoubts     DoubtTicket[]    @relation("AssignedTeacher")
  createdNotices     Notice[]         @relation("NoticeCreator")
  permissionGrants   UserPermissionGrant[] @relation("GrantHolder")
  permissionGrantsIssued UserPermissionGrant[] @relation("GrantIssuer")
  refreshTokens      RefreshToken[]

  @@unique([instituteId, email])
  @@unique([instituteId, googleSub])
  @@index([email])
  @@index([instituteId, role])
  @@map("users")
}

/// Refresh-token sessions (07-SECURITY-SPECIFICATION.md).
///
/// WHY THIS EXISTS: the only session credential used to be a 7-day access JWT
/// held in localStorage. A stolen one stayed valid for up to a week, and the
/// only revocation available was User.tokenVersion, which logs the user out of
/// EVERY device at once — too blunt to use on a single suspicious session, so
/// in practice it would not be used at all.
///
/// The token VALUE is never stored. Only its SHA-256 hash is, so a read of this
/// table — a leaked backup, a SQL-injection, an over-broad support query — does
/// not yield usable credentials. This is the same reasoning as never storing
/// passwords in plaintext, and it is why `tokenHash` is what carries @unique.
///
/// ROTATION AND REUSE DETECTION. Every refresh mints a new token and marks the
/// presented one `rotatedAt`. A correctly behaving client therefore never sends
/// the same refresh token twice. If an already-rotated token is presented, there
/// are two copies of it in the world — the legitimate client's and a thief's —
/// and there is no way to tell which one just arrived. The whole `familyId`
/// chain is revoked, forcing a fresh login. That converts silent, indefinite
/// session theft into a single visible logout.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// Rotation chain. Every token descended from one login shares this, so reuse
  /// detection can revoke the compromised session without touching the user's
  /// other devices.
  familyId  String
  /// SHA-256 of the opaque token. Never the token itself — see the note above.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Set when this token is exchanged for a successor. Non-null means "already
  /// used"; presenting it again is the reuse signal.
  rotatedAt DateTime?
  revokedAt DateTime?
  /// Why it was revoked — "logout", "rotated", "reuse_detected", "force_logout".
  /// Kept for incident review: "was this session ended by the user or by us?"
  revokedReason String?
  /// Coarse client fingerprint, for showing a user their own sessions and for
  /// triage after a reuse event. Deliberately not a device identifier and not
  /// used for any authorization decision — both are trivially spoofed by the
  /// client that sends them.
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Listing and bulk-revoking a user's sessions.
  @@index([userId])
  /// Reuse detection revokes by family, so this is on the hot path of the one
  /// operation that has to be fast when it matters.
  @@index([familyId])
  /// Lets the cleanup job find expired rows without scanning the table, which
  /// otherwise grows without bound — one row per refresh, forever.
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Phase 14 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md) — 21-DOMAIN-MODEL-V2.md
/// §4.10 sketches a full Role/Permission/Scope-as-data framework ("so that
/// FUTURE roles... can be added as data, not new enum values"), but its own
/// concrete schema is deferred to a 06B-AUTH-AUTHORIZATION-V2.md that does
/// not exist in this docs pack. Rather than build that full generic
/// framework speculatively, this is the minimal, real, additive mechanism
/// Phase 14 actually needs: grant one named permission (optionally scoped
/// to a batch/subject) to a specific user, without introducing a new Role
/// entity — doc 25 §4.3 itself frames REVIEW_EVALUATION as "not necessarily
/// a new hardcoded role, could be an ADMIN or a delegated senior TEACHER
/// granted this permission." The 4-role enum stays authoritative for
/// baseline access; this is a strictly additive, parallel check layered on
/// top for capabilities the base roles don't automatically carry.
model UserPermissionGrant {
  id              String   @id @default(cuid())
  userId          String
  permission      String   // e.g. "REVIEW_EVALUATION" — string, not an enum, matching doc 21 §4.10's own "as data" framing
  batchId         String?  // scope — null means institute-wide for this permission
  subjectId       String?  // scope
  grantedByUserId String
  createdAt       DateTime @default(now())

  user User @relation("GrantHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("GrantIssuer", fields: [grantedByUserId], references: [id])

  @@unique([userId, permission, batchId, subjectId])
  @@index([userId, permission])
  @@map("user_permission_grants")
}

// ---------------------------------------------------------------------------
// STUDENT MANAGEMENT
// ---------------------------------------------------------------------------

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  /// Denormalized copy of User.instituteId for direct tenant filtering.
  /// Eliminates the join-through-User footgun: any query that forgets the join
  /// would otherwise return cross-tenant data. Backfilled on migration.
  instituteId     String
  studentCode     String?  // Institute-scoped readable student identifier (e.g. "STU-2026-0001")
  rollNumber      String?
  externalIds     Json?    // Official external identifiers (CBSE roll, state board ID)
  dateOfBirth     DateTime?
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?
  address         String?
  photoUrl        String?
  documents       String[] // S3/Supabase URLs
  tags            String[] // e.g. ["high-risk", "needs-revision"]
  batchId         String?
  admissionDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch           Batch?           @relation(fields: [batchId], references: [id])
  enrollments     BatchEnrollment[]
  scoreRecords    ScoreRecord[]
  masteryScores   MasteryScore[]
  assignments     Assignment[]
  doubtTickets    DoubtTicket[]
  answerSheets    AnswerSheet[]
  interventions   Intervention[]   @relation("StudentInterventions")
  profileHistory  StudentHistory[]
  attempts        Attempt[]
  attendanceRecords AttendanceRecord[]
  attendanceRosters AttendanceSessionRoster[]
  conceptMasteries  StudentConceptMastery[]
  questionExposures StudentQuestionExposure[]
  copyCheckerAllocations CopyCheckerStudentAllocation[]

  @@unique([instituteId, studentCode])
  @@index([batchId])
  @@index([instituteId])
  @@index([instituteId, admissionDate])
  @@map("student_profiles")
}

/// Immutable log of any change to a student profile — promotions, batch transfers, tag changes.
model StudentHistory {
  id               String   @id @default(cuid())
  studentProfileId String
  eventType        String   // e.g. "BATCH_TRANSFER", "TAG_ADDED", "PROMOTION"
  description      String
  oldValue         String?
  newValue         String?
  changedAt        DateTime @default(now())
  changedByUserId  String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("student_history")
}

// ---------------------------------------------------------------------------
// TEACHER MANAGEMENT
// ---------------------------------------------------------------------------

model TeacherProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  teacherCode        String?  // Institute-scoped readable teacher identifier (e.g. "TCH-PHY-01")
  qualification      String?
  subjectIds         String[] // references Subject.id
  availability       Json?    // weekly schedule blocks
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchAssignments   BatchTeacher[]
  copyCheckerAssignments CopyCheckerAssignment[]

  @@map("teacher_profiles")
}

// ---------------------------------------------------------------------------
// BATCHES / CLASSES / SECTIONS
// ---------------------------------------------------------------------------

model Batch {
  id          String   @id @default(cuid())
  instituteId String
  branchId    String?
  name        String   // e.g. "JEE Advanced 2026 - Batch A"
  classYear   String?  // e.g. "Class 11"
  section     String?
  academicYear String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute   Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch      Branch?        @relation(fields: [branchId], references: [id])
  teachers    BatchTeacher[]
  students    StudentProfile[]
  enrollments BatchEnrollment[]
  exams       Exam[]
  timetableSlots TimetableSlot[]
  assignments Assignment[]
  assessmentDeliveries AssessmentDelivery[]
  attendanceRecords AttendanceRecord[]
  attendanceSessions AttendanceSession[]

  @@index([instituteId])
  @@map("batches")
}

/// Many-to-many join table for batch ↔ teacher assignments.
model BatchTeacher {
  id               String   @id @default(cuid())
  batchId          String
  teacherProfileId String
  subjectId        String?
  assignedAt       DateTime @default(now())
  removedAt        DateTime?

  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherProfileId, subjectId])
  @@index([teacherProfileId, removedAt])
  @@map("batch_teachers")
}

// ---------------------------------------------------------------------------
// CURRICULUM — SUBJECTS / CHAPTERS / TOPICS
// ---------------------------------------------------------------------------

model Subject {
  id          String   @id @default(cuid())
  instituteId String
  name        String
  code        String?
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  // Universal Curriculum extensions
  boardId             String?
  gradeLevelId        String?
  curriculumVersionId String?
  isGlobal            Boolean             @default(false)
  category            String              @default("STEM") // STEM, HUMANITIES, LANGUAGES, COMMERCE

  board               AcademicBoard?      @relation(fields: [boardId], references: [id])
  gradeLevel          GradeLevel?         @relation(fields: [gradeLevelId], references: [id])
  curriculumVersion   CurriculumVersion?  @relation(fields: [curriculumVersionId], references: [id])

  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  questions   Question[]
  blueprints  Blueprint[]
  doubtTickets DoubtTicket[]
  masteryScores MasteryScore[]

  @@unique([instituteId, name])
  @@map("subjects")
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@map("chapters")
}

model Topic {
  id        String   @id @default(cuid())
  chapterId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  chapter       Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  concepts      Concept[]
  questions     Question[]
  masteryScores MasteryScore[]
  assignments   Assignment[]
  interventions Intervention[]
  doubtTickets  DoubtTicket[]

  @@map("topics")
}

// ---------------------------------------------------------------------------
// QUESTION BANK
// ---------------------------------------------------------------------------

model Question {
  id              String          @id @default(cuid())
  instituteId     String
  subjectId       String
  chapterId       String
  topicId         String
  type            QuestionType
  difficulty      DifficultyLevel
  marks           Float
  negativeMarks   Float           @default(0)
  content         String          // question text (supports markdown/LaTeX)
  options         Json?           // for MCQ — array of {label, text, isCorrect}
  solution        String?         // explanation
  sourceRef       String?         // textbook/source reference
  qualityScore    Float?          // computed by AI review
  isApproved      Boolean         @default(false)
  approvedByUserId String?
  approvedAt      DateTime?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  // 04-DATABASE-SCHEMA.md (V2 section) §3.2 — additive, nullable, no migration
  // impact on existing rows. Denormalized convenience pointer; Rubric.questionId
  // (below) is the enforced ownership FK.
  rubricId        String?

  // ── Universal Curriculum, Cognitive & Taxonomy Extensions ──
  bloomsLevel           BloomsTaxonomyLevel @default(UNDERSTAND)
  status                QuestionStatus      @default(APPROVED)
  sourceType            QuestionSourceType  @default(INSTITUTE_CURATED)
  sourceDetails         Json?               // { textbookName, editionYear, chapterNo, exerciseNo, pageNo, examYear, pyqBoard }
  contentHash           String?             // SHA-256 hash for exact deduplication
  fingerprint           String?             // Normalized token stem fingerprint for near-duplicate similarity
  expectedTimeSec       Int?                @default(120)
  language              String              @default("en")
  canonicalQuestionId   String?
  typePayload           Json?               // Extensible structured metadata for Visual, CS/Code, Case Study sub-items
  empiricalDifficulty   Float?              // IRT p-value: fraction of correct attempts (0.0 to 1.0)
  discriminationIndex   Float?              // Item discrimination (point biserial correlation)
  attemptCount          Int                 @default(0)
  correctCount          Int                 @default(0)
  avgTimeSpentSec       Float?
  isGlobal              Boolean             @default(false) // Standardized central bank / NCERT content
  gradeLevelId          String?
  curriculumVersionId   String?

  // ── Question Family & Variant Tree ──
  familyId              String?
  parentQuestionId      String?
  variantType           QuestionVariantType @default(ORIGINAL)

  institute             Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subject               Subject             @relation(fields: [subjectId], references: [id])
  chapter               Chapter             @relation(fields: [chapterId], references: [id])
  topic                 Topic               @relation(fields: [topicId], references: [id])
  family                QuestionFamily?     @relation(fields: [familyId], references: [id])
  parentQuestion        Question?           @relation("QuestionVariants", fields: [parentQuestionId], references: [id])
  variants              Question[]          @relation("QuestionVariants")
  canonicalQuestion     Question?           @relation("QuestionTranslations", fields: [canonicalQuestionId], references: [id])
  translations          Question[]          @relation("QuestionTranslations")
  gradeLevel            GradeLevel?         @relation(fields: [gradeLevelId], references: [id])
  curriculumVersion     CurriculumVersion?  @relation(fields: [curriculumVersionId], references: [id])

  versions              QuestionVersion[]
  paperItems            PaperItem[]
  responses             Response[]
  rubric                Rubric?
  concepts              QuestionConcept[]
  learningObjectives    QuestionLearningObjective[]
  studentExposures      StudentQuestionExposure[]
  copyCheckerAllocations CopyCheckerQuestionAllocation[]

  @@index([instituteId, subjectId, topicId, difficulty])
  @@index([instituteId, createdAt(sort: Desc)])
  @@index([isApproved])
  @@index([familyId])
  @@index([contentHash])
  @@index([fingerprint])
  @@index([bloomsLevel])
  @@index([status])
  @@index([isGlobal, subjectId, difficulty])
  @@map("questions")
}

/// Immutable history of every edit to a question — locked once approved.
model QuestionVersion {
  id         String   @id @default(cuid())
  questionId String
  versionNo  Int
  content    String
  options    Json?
  solution   String?
  createdBy  String
  createdAt  DateTime @default(now())

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  paperItems PaperItem[]
  aiRecommendations AIRecommendation[]

  @@unique([questionId, versionNo])
  @@map("question_versions")
}

// ---------------------------------------------------------------------------
// UNIVERSAL CURRICULUM ARCHITECTURE (Class 1-12, NCERT, Boards)
// ---------------------------------------------------------------------------

enum BloomsTaxonomyLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum QuestionVariantType {
  ORIGINAL
  REPHRASED
  PARAMETERIZED
  CONCEPT_VARIANT
  DIFFICULTY_VARIANT
  CONTEXT_VARIANT
  LANGUAGE_TRANSLATION
}

enum QuestionStatus {
  DRAFT
  AI_GENERATED
  VALIDATION_PENDING
  TEACHER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum QuestionSourceType {
  NCERT_TEXTBOOK
  NCERT_EXEMPLAR
  PREVIOUS_YEAR_EXAM
  TEACHER_ORIGINAL
  AI_GENERATED
  THIRD_PARTY_IMPORT
  INSTITUTE_CURATED
}

enum PrerequisiteRelationType {
  STRICT_PREREQUISITE
  RECOMMENDED_PREPARATION
  CO_REQUISITE
}

enum PaperAssessmentCategory {
  MAJOR_EXAM
  REGULAR_TEST
  LEARNING_HOMEWORK
  INTELLIGENT_PERSONALIZED
}

model AcademicBoard {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "NCERT", "CBSE", "ICSE", "STATE_MAHARASHTRA"
  name        String
  country     String   @default("India")
  state       String?
  description String?
  isGlobal    Boolean  @default(true)
  createdAt   DateTime @default(now())

  curriculumVersions CurriculumVersion[]
  subjects           Subject[]

  @@map("academic_boards")
}

model CurriculumVersion {
  id            String   @id @default(cuid())
  boardId       String
  academicYear  String   // e.g. "2024-2025", "2026-2027"
  versionLabel  String   // e.g. "NCERT-Rationalised-2024"
  status        String   @default("ACTIVE") // ACTIVE, DEPRECATED, DRAFT
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  board         AcademicBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  subjects      Subject[]
  questions     Question[]

  @@unique([boardId, academicYear, versionLabel])
  @@map("curriculum_versions")
}

model GradeLevel {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "CLASS_1", "CLASS_10", "CLASS_12"
  name          String   // e.g. "Class 10"
  sequenceOrder Int      @unique // 1 to 12
  stage         String   @default("SECONDARY") // FOUNDATIONAL, PREPARATORY, MIDDLE, SECONDARY, SENIOR_SECONDARY
  createdAt     DateTime @default(now())

  subjects      Subject[]
  questions     Question[]

  @@map("grade_levels")
}

model Concept {
  id          String    @id @default(cuid())
  topicId     String
  code        String?
  name        String
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  topic               Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  learningObjectives  LearningObjective[]
  questions           QuestionConcept[]
  prerequisites       ConceptPrerequisite[] @relation("DependentConcept")
  dependedOnBy        ConceptPrerequisite[] @relation("PrerequisiteConcept")
  studentMasteries    StudentConceptMastery[]
  questionFamilies    QuestionFamily[]

  @@index([topicId, order])
  @@map("concepts")
}

model ConceptPrerequisite {
  id                    String                   @id @default(cuid())
  conceptId             String
  prerequisiteConceptId String
  relationType          PrerequisiteRelationType @default(STRICT_PREREQUISITE)
  createdAt             DateTime                 @default(now())

  concept               Concept @relation("DependentConcept", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisiteConcept   Concept @relation("PrerequisiteConcept", fields: [prerequisiteConceptId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteConceptId])
  @@map("concept_prerequisites")
}

model LearningObjective {
  id          String              @id @default(cuid())
  conceptId   String?
  code        String              // e.g. "LO-MATH-10-QUAD-01"
  description String              // "Determine nature of roots using discriminant"
  bloomsLevel BloomsTaxonomyLevel @default(APPLY)
  createdAt   DateTime            @default(now())

  concept     Concept?            @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  questions   QuestionLearningObjective[]

  @@unique([code])
  @@map("learning_objectives")
}

model QuestionConcept {
  id         String   @id @default(cuid())
  questionId String
  conceptId  String
  isPrimary  Boolean  @default(false)
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([questionId, conceptId])
  @@map("question_concepts")
}

model QuestionLearningObjective {
  id                  String   @id @default(cuid())
  questionId          String
  learningObjectiveId String
  createdAt           DateTime @default(now())

  question          Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  learningObjective LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@unique([questionId, learningObjectiveId])
  @@map("question_learning_objectives")
}

model QuestionFamily {
  id              String   @id @default(cuid())
  instituteId     String?  // null = global/NCERT template; set = institute private template
  code            String   @unique
  name            String
  baseConceptId   String?
  templatePrompt  String?  // for AI generative variants
  parameterSchema Json?    // variable definitions: { a: "range(1, 10)", b: "..." }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  baseConcept Concept?   @relation(fields: [baseConceptId], references: [id])
  questions   Question[]

  @@index([instituteId])
  @@map("question_families")
}

model StudentConceptMastery {
  id               String   @id @default(cuid())
  studentProfileId String
  conceptId        String
  masteryScore     Float    @default(0.5) // 0.0 to 1.0
  confidence       Float    @default(0.0) // 0.0 to 1.0
  attemptsCount    Int      @default(0)
  lastAttemptAt    DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  concept        Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, conceptId])
  @@index([studentProfileId, masteryScore])
  @@map("student_concept_masteries")
}

model StudentQuestionExposure {
  id               String    @id @default(cuid())
  studentProfileId String
  questionId       String
  paperId          String?
  attemptedAt      DateTime  @default(now())
  wasCorrect       Boolean?
  timeSpentSec     Int?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  paper          Paper?         @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, questionId])
  @@index([studentProfileId, attemptedAt])
  @@map("student_question_exposures")
}

// ---------------------------------------------------------------------------
// BLUEPRINTS & PAPERS
// ---------------------------------------------------------------------------

model Blueprint {
  id            String   @id @default(cuid())
  instituteId   String
  subjectId     String
  name          String
  totalMarks    Float
  duration      Int      // minutes
  instructions  String?
  distribution  Json     // [{topicId, marks, difficulty, count}]
  
  // V2 fields
  format                 PaperFormat @default(OMR)
  sections               Json?       // Stores PaperSection[]
  difficultyDistribution Json?       // Stores { easy, medium, hard }
  bloomsDistribution     Json?       // Stores { remember, understand, apply, analyze, evaluate, create }

  createdByUserId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id])
  exams     Exam[]
  papers    Paper[]

  @@map("blueprints")
}

model Paper {
  id              String      @id @default(cuid())
  instituteId     String
  blueprintId     String
  examId          String?
  title           String
  status          PaperStatus @default(DRAFT)
  format          PaperFormat @default(OMR)
  category        PaperAssessmentCategory @default(REGULAR_TEST)
  isPersonalized  Boolean     @default(false)
  targetStudentId String?     // null = general; set = personalized for specific student
  targetBatchId   String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedByUserId String?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institute        Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  blueprint        Blueprint      @relation(fields: [blueprintId], references: [id])
  exam             Exam?          @relation(fields: [examId], references: [id])
  items            PaperItem[]
  versions         PaperVersion[]
  assessments      Assessment[]
  studentExposures StudentQuestionExposure[]

  @@index([instituteId, status])
  @@map("papers")
}

model PaperVersion {
  id          String   @id @default(cuid())
  paperId     String
  versionNo   Int
  setLabel    String?  // "Set A", "Set B" for anti-cheating sets
  createdAt   DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, versionNo])
  @@map("paper_versions")
}

model PaperItem {
  id                String @id @default(cuid())
  paperId           String
  questionId        String
  questionVersionId String? // Pinned immutable snapshot of the question at publication time
  order             Int
  marks             Float  // override if different from question default
  sectionId         String? // V2 - Which section this question belongs to in Theory/Hybrid papers

  paper           Paper            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id])
  questionVersion QuestionVersion? @relation(fields: [questionVersionId], references: [id])

  @@unique([paperId, questionId])
  @@map("paper_items")
}

// ---------------------------------------------------------------------------
// EXAMS
// ---------------------------------------------------------------------------

model Exam {
  id              String     @id @default(cuid())
  instituteId     String
  batchId         String
  blueprintId     String
  title           String
  type            ExamType
  format          PaperFormat @default(OMR)
  status          ExamStatus @default(DRAFT)
  version         Int        @default(0) // optimistic lock — 18-EDGE-CASES.md: concurrent transitions get 409, not a silent overwrite
  scheduledDate   DateTime?
  durationMinutes Int?
  venue           String?
  createdByUserId String
  approvedByUserId String?
  approvedAt      DateTime?
  publishedAt     DateTime?
  lockedAt        DateTime?
  lockedByUserId  String?
  unlockReason    String?    // required when Admin unlocks a locked exam
  captureMode     CaptureMode @default(MANUAL_GRID)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  assessmentDeliveryId String? @unique // Canonical bridge to v2 AssessmentDelivery

  institute          Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch              Batch               @relation(fields: [batchId], references: [id])
  blueprint          Blueprint           @relation(fields: [blueprintId], references: [id])
  assessmentDelivery AssessmentDelivery? @relation(fields: [assessmentDeliveryId], references: [id])
  papers             Paper[]
  answerSheets       AnswerSheet[]
  scoreRecords       ScoreRecord[]

  @@index([instituteId, status])
  @@index([batchId])
  @@index([instituteId, batchId, createdAt(sort: Desc)])
  @@index([instituteId, createdAt(sort: Desc)])
  @@map("exams")
}

// ---------------------------------------------------------------------------
// MARKS CAPTURE
// ---------------------------------------------------------------------------

model AnswerSheet {
  id               String   @id @default(cuid())
  examId           String
  studentProfileId String
  captureMode      CaptureMode
  photoUrl         String?  // for PHOTO_CAPTURE mode
  omrFilePath      String?  // for OMR_IMPORT mode
  isVerified       Boolean  @default(false)
  verifiedByUserId String?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  responses      Response[]

  @@unique([examId, studentProfileId])
  @@index([studentProfileId])
  @@map("answer_sheets")
}

model ScoreRecord {
  id               String   @id @default(cuid())
  examId           String?
  studentProfileId String
  totalMarks       Float    // max possible
  obtainedMarks    Float
  percentage       Float
  rank             Int?
  evaluatedByUserId String?
  evaluatedAt      DateTime?
  isFinalized      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // Phase 12 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md) addition — same bridge
  // pattern as Response.attemptId (Phase 8): examId was loosened from
  // required to optional so a ScoreRecord can belong to EITHER a v1 Exam or
  // a v2 Attempt, never neither. Attempt already pins its studentProfileId
  // uniquely per delivery, so a single-column unique on attemptId is enough
  // (no composite needed, unlike the v1 examId+studentProfileId pair).
  attemptId        String?  @unique

  exam           Exam?           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id])
  attempt        Attempt?        @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([examId, studentProfileId])
  @@index([studentProfileId])
  @@map("score_records")
}

/// Question-level response with mistake tagging.
model Response {
  id               String          @id @default(cuid())
  answerSheetId    String?
  questionId       String
  marksAwarded     Float
  marksAvailable   Float
  isCorrect        Boolean?
  studentAnswer    String?         // text or option label
  mistakeTags      MistakeTagType[]
  teacherComment   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  // Phase 8 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md) — additive: a Response now
  // belongs to EITHER a v1 AnswerSheet (answerSheetId) OR a v2 Attempt
  // (attemptId), never neither. answerSheetId was loosened from required to
  // optional to allow this — fully backward-compatible, since every existing
  // v1 write path already always supplies it. evidenceType is null on every
  // pre-Phase-8 row (legacy v1 shape); Phase 8's CaptureProvider ingest always
  // sets it. This is NOT the doc 04 §3.1 Response redefinition (still
  // deferred, still unexecuted — see response_v2_migration.sql) — that
  // migration additionally moves marksAwarded/mistakeTags/teacherComment off
  // this table entirely, which this change does not do.
  attemptId        String?
  evidenceType     EvidenceType?
  // Phase 10 addition — populated only for evidenceType=PAGE_REGION rows,
  // pointing at the confirmed QuestionRegion (a PageRegion with questionId
  // set) this evidence came from. Null for DIGITAL_VALUE/OMR_MARK rows.
  questionRegionId String?

  answerSheet   AnswerSheet? @relation(fields: [answerSheetId], references: [id], onDelete: Cascade)
  attempt       Attempt?     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question     @relation(fields: [questionId], references: [id])
  questionRegion PageRegion? @relation(fields: [questionRegionId], references: [id])

  // V2 bridge (see the additive-block comment above AssessmentKind): Evaluation
  // and AIRecommendation FK into this existing v1 row as-is, ahead of the
  // Response redefinition migration (packages/db/manual-sql/response_v2_migration.sql).
  evaluation        Evaluation?
  aiRecommendations AIRecommendation[]

  @@unique([answerSheetId, questionId])
  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([createdAt])
  @@map("responses")
}

// ---------------------------------------------------------------------------
// ANALYSIS — MASTERY SCORES & INTERVENTIONS
// ---------------------------------------------------------------------------

model MasteryScore {
  id               String   @id @default(cuid())
  studentProfileId String
  subjectId        String
  topicId          String
  masteryValue     Float    // 0.0 – 1.0
  trend            Float    @default(0) // positive = improving, negative = declining
  sampleCount      Int      @default(0) // number of responses used to compute this
  lastUpdatedAt    DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // V2 Analytics/Mastery Integration phase — atomic idempotency claim for
  // auto-generated interventions. NULL = no intervention currently in flight
  // for this student+topic; set = one was already triggered for the current
  // weak-topic episode, cleared automatically once mastery recovers above
  // threshold. Deliberately reuses this row's existing @@unique([studentProfileId,
  // topicId]) constraint below rather than adding a new one: a conditional
  // update_many(where={..., interventionTriggeredAt: null}) against that
  // already-unique row is what makes the claim race-safe at the DB level,
  // not just an application-level check-then-create.
  interventionTriggeredAt DateTime?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id])
  topic          Topic          @relation(fields: [topicId], references: [id])

  @@unique([studentProfileId, topicId])
  @@index([studentProfileId, subjectId])
  @@index([topicId, masteryValue])
  @@map("mastery_scores")
}

model Intervention {
  id               String   @id @default(cuid())
  instituteId      String
  studentProfileId String
  topicId          String
  type             String   // "EXTRA_CLASS", "ASSIGNMENT", "DOUBT_SESSION", "REMEDIAL_GROUP"
  description      String?
  beforeMastery    Float?
  afterMastery     Float?
  scheduledAt      DateTime?
  completedAt      DateTime?
  createdByUserId  String
  createdAt        DateTime @default(now())

  institute      Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation("StudentInterventions", fields: [studentProfileId], references: [id])
  topic          Topic          @relation(fields: [topicId], references: [id])

  @@index([studentProfileId, topicId])
  @@index([instituteId])
  @@map("interventions")
}

// ---------------------------------------------------------------------------
// TIMETABLE
// ---------------------------------------------------------------------------

model TimetableSlot {
  id          String            @id @default(cuid())
  instituteId String
  batchId     String?
  type        TimetableSlotType
  title       String
  teacherUserId String?
  subjectId   String?
  roomRef     String?
  startTime   DateTime
  endTime     DateTime
  isRecurring Boolean           @default(false)
  recurRule   String?           // iCal RRULE string for recurring slots
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch?    @relation(fields: [batchId], references: [id])

  attendanceSessions  AttendanceSession[]
  timetableExceptions TimetableException[]

  @@index([instituteId, startTime])
  @@index([batchId, startTime])
  @@index([instituteId, teacherUserId, startTime])
  @@map("timetable_slots")
}

// ---------------------------------------------------------------------------
// ATTENDANCE V4 PRODUCTION ENGINE
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TimetableExceptionType {
  CANCELLED
  SUBSTITUTE
  RESCHEDULED
}

model AttendanceSession {
  id                    String      @id @default(cuid())
  instituteId           String
  timetableSlotId       String?     // Nullable: supports legacy migration & slot deletion preservation
  date                  String      // "YYYY-MM-DD" authoritative institute-local calendar date
  batchId               String      // Active batch at session time
  subjectId             String?     // Subject taught during session

  // Immutability Snapshots (Preserved even if timetable/teachers change later)
  snapshotTeacherUserId String      // User ID of scheduled teacher
  snapshotTeacherName   String      // Display name captured at session creation
  snapshotSubjectName   String?     // Subject name captured at session creation
  snapshotBatchName     String      // Batch name captured at session creation
  snapshotPeriodNumber  Int?        // Period index (e.g. 1, 2, 3)
  snapshotStartTime     DateTime    // Scheduled slot start (UTC)
  snapshotEndTime       DateTime    // Scheduled slot end (UTC)
  snapshotRoom          String?     // Room or lecture hall reference

  // Roster Snapshot Gate
  rosterSnapshotAt      DateTime?   // Timestamp when roster was frozen; NULL = pre-open listing

  // Operator Overrides & Substitutions
  substituteUserId      String?     // Set if TimetableException(SUBSTITUTE) is active

  // Official Exam Overlap Suppressor
  examOverrideId        String?     // Set if suppressed by an official scheduled Exam

  // Session Lifecycle State
  finalizedAt           DateTime?   // NULL = Draft/In-Progress; Set = Locked & Published
  finalizedByUserId     String?
  cancelledAt           DateTime?   // Set if class was cancelled
  cancelledReason       String?
  cancelledByUserId     String?

  // Concurrency Control
  version               Int         @default(1) // Incremented on every mutation (OCC)

  // Idempotent Alert Markers
  missingAlertSentAt    DateTime?   // Timestamp when missing notification was dispatched
  missingAlertJobId     String?     // BullMQ job deduplication identifier

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Protected Relations (onDelete: Restrict prevents accidental data loss)
  institute             Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  timetableSlot         TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  batch                 Batch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  roster                AttendanceSessionRoster[]
  records               AttendanceRecord[]
  correctionLogs        AttendanceCorrectionLog[]

  @@unique([timetableSlotId, date])
  @@index([instituteId, date])
  @@index([batchId, date])
  @@index([snapshotTeacherUserId, date])
  @@index([substituteUserId, date])
  @@index([instituteId, finalizedAt, cancelledAt])
  @@map("attendance_sessions")
}

model AttendanceSessionRoster {
  id               String            @id @default(cuid())
  sessionId        String
  studentProfileId String
  snapshotRollNo   String?           // Roll number at time of session freeze
  snapshotName     String            // Student name at time of session freeze
  enrolledAtTime   DateTime          @default(now())

  session          AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentProfileId])
  @@index([sessionId])
  @@map("attendance_session_rosters")
}

model AttendanceRecord {
  id                String            @id @default(cuid())
  sessionId         String?           // Nullable for zero-downtime expand phase
  studentProfileId  String
  batchId           String
  subjectId         String?
  date              DateTime          // Preserved for legacy compatibility during expand/contract
  status            AttendanceStatus  // PRESENT | ABSENT | LATE | EXCUSED
  markedByUserId    String            // User who marked/autosaved this entry
  version           Int               @default(1) // Record-level optimistic concurrency

  // Audited Correction Tracking (Post-Finalization)
  correctedAt       DateTime?
  correctionReason  String?
  correctedByUserId String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  session           AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfile    StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  batch             Batch              @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentProfileId])
  @@index([sessionId])
  @@index([batchId, date])
  @@index([studentProfileId, subjectId])
  @@map("attendance_records")
}

model AttendanceCorrectionLog {
  id                String            @id @default(cuid())
  instituteId       String
  sessionId         String
  recordId          String
  studentProfileId  String
  previousStatus    AttendanceStatus
  newStatus         AttendanceStatus
  reason            String            // Required (min length: 10 chars)
  correctedByUserId String
  createdAt         DateTime          @default(now())

  institute         Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  session           AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([recordId])
  @@index([instituteId, createdAt])
  @@map("attendance_correction_logs")
}

model TimetableException {
  id                String                 @id @default(cuid())
  instituteId       String
  timetableSlotId   String
  date              String                 // "YYYY-MM-DD" source occurrence
  type              TimetableExceptionType // CANCELLED | SUBSTITUTE | RESCHEDULED
  substituteUserId  String?
  targetDate        String?                // "YYYY-MM-DD" if cross-date rescheduled
  overrideStart     DateTime?
  overrideEnd       DateTime?
  reason            String
  createdByUserId   String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  institute         Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  timetableSlot     TimetableSlot          @relation(fields: [timetableSlotId], references: [id], onDelete: Restrict)

  @@unique([timetableSlotId, date])
  @@index([instituteId, date])
  @@index([substituteUserId, date])
  @@map("timetable_exceptions")
}

// ---------------------------------------------------------------------------
// DOUBTS
// ---------------------------------------------------------------------------

model DoubtTicket {
  id               String      @id @default(cuid())
  studentProfileId String
  subjectId        String
  topicId          String?
  urgency          Int         @default(1) // 1=low, 2=medium, 3=high
  status           DoubtStatus @default(OPEN)
  content          String      // text description
  attachmentUrls   String[]
  assignedTeacherId String?
  responseText     String?     // 04-DATABASE-SCHEMA.md: the resolving teacher/admin's answer
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  studentProfile  StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject         Subject        @relation(fields: [subjectId], references: [id])
  topic           Topic?         @relation(fields: [topicId], references: [id])
  assignedTeacher User?          @relation("AssignedTeacher", fields: [assignedTeacherId], references: [id])

  @@index([studentProfileId, status])
  @@map("doubt_tickets")
}

// ---------------------------------------------------------------------------
// ASSIGNMENTS
// ---------------------------------------------------------------------------

model Assignment {
  id               String           @id @default(cuid())
  batchId          String?
  studentProfileId String?          // null = batch-wide; set = individual
  topicId          String
  title            String
  description      String?
  dueDate          DateTime
  status           AssignmentStatus @default(PENDING)
  submissionUrl    String?
  submittedAt      DateTime?
  gradedMarks      Float?
  gradedByUserId   String?
  gradedAt         DateTime?
  isAutoGenerated  Boolean          @default(false) // true = generated from weak topics
  createdByUserId  String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  batch          Batch?          @relation(fields: [batchId], references: [id])
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id])
  topic          Topic           @relation(fields: [topicId], references: [id])

  @@index([batchId, dueDate])
  @@index([studentProfileId])
  @@map("assignments")
}

// ---------------------------------------------------------------------------
// COMMUNICATION CENTER
// ---------------------------------------------------------------------------

model Notice {
  id              String        @id @default(cuid())
  instituteId     String
  createdByUserId String
  title           String
  body            String
  targetAudience  Json          // {roles: [], batchIds: [], studentIds: []}
  channels        NoticeChannel[]
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime      @default(now())

  institute    Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("NoticeCreator", fields: [createdByUserId], references: [id])
  deliveries   NoticeDelivery[]

  @@map("notices")
}

model NoticeDelivery {
  id            String         @id @default(cuid())
  noticeId      String
  userId        String
  channel       NoticeChannel
  status        DeliveryStatus @default(QUEUED)
  failureReason String?        // 04-DATABASE-SCHEMA.md: e.g. "no_contact_info", "provider_not_configured"
  sentAt        DateTime?
  readAt        DateTime?

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId, status])
  @@index([userId])
  @@map("notice_deliveries")
}

// ---------------------------------------------------------------------------
// REPORTS
// ---------------------------------------------------------------------------

enum ReportStatus {
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

model Report {
  id                String       @id @default(cuid())
  instituteId       String
  type              ReportType
  scope             Json         // 04-DATABASE-SCHEMA.md: { studentId? | batchId?, dateFrom?, dateTo? }
  format            String       @default("PDF") // "PDF" | "EXCEL"
  status            ReportStatus @default(QUEUED)
  fileUrl           String?      // signed URL, set once status = COMPLETE
  requestedByUserId String
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  // Phase 14 addition — 31-EVALUATION-AUDIT-VERSIONING.md §4: a post-dispute
  // score correction reissues an updated Report rather than silently
  // replacing the original; both remain retrievable.
  supersedesReportId String?     @unique

  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  supersedes  Report?   @relation("ReportSupersession", fields: [supersedesReportId], references: [id])
  supersededBy Report?  @relation("ReportSupersession")

  @@index([instituteId, type])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// AUDIT LOG — cross-cuts every sensitive action
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  instituteId String?     // 04-DATABASE-SCHEMA.md: nullable for FOUNDER-global actions
  actorId     String      // User.id
  action      AuditAction
  entity      String      // table name, e.g. "exams", "papers"
  entityId    String
  oldValue    Json?
  newValue    Json?
  reason      String?     // required for unlock / sensitive actions
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  actor     User      @relation("AuditActor", fields: [actorId], references: [id])

  @@index([instituteId, createdAt])
  @@index([actorId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// =============================================================================
// V2 DOMAIN MODEL — 21-DOMAIN-MODEL-V2.md / 04-DATABASE-SCHEMA.md (V2 section)
// =============================================================================
// Phase 7 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md): additive only. Every model
// below is net-new — no v1 table above this line is modified except for the
// safe, non-breaking additions already made in place (Institute/Question/Batch/
// StudentProfile/Paper back-relations; Question.rubricId).
//
// Deliberately NOT done here: the v1 Response "redefinition" (04-DATABASE-
// SCHEMA.md V2 §3.1) — moving marksAwarded/mistakeTagType/teacherComment/
// gradedByUserId/gradedAt off Response and onto EvaluationVersion, ultimately
// dropping those columns. That migration requires a real database to run
// against and verify row-count parity on before any DROP COLUMN, which this
// environment has never had (no prisma/migrations/ history exists at all).
// Doing it without that verification would both risk real data loss on a
// future real deployment and immediately break already-working v1 grading/
// mastery code with nothing tested behind it. The script is written, not
// executed: packages/db/manual-sql/response_v2_migration.sql.
//
// Bridging decision (not verbatim from the doc, flagged here): Evaluation and
// AIRecommendation both need a responseId to attach to. Since the v1 Response
// table's shape isn't changing yet, they FK into the EXISTING v1 Response.id
// as-is. This is a deliberate, temporary bridge so Rubric/Evaluation-adjacent
// work in later phases has something real to attach to without waiting on the
// Response migration — not a literal transcription of the doc's "Response
// (redefined)" wiring, which assumes the migration has already happened.
//
// Also deliberately NOT done: the AnswerSheet.isActiveAttempt addition doc 04
// V2's "New Indexes" table bundles in alongside Attempt (fix #2). Adding the
// column alone is safe, but changing AnswerSheet's unique constraint to
// [examId, studentProfileId, isActiveAttempt] changes an existing v1 table's
// duplicate-prevention guarantee, and no v1 code (ExamsService.createAnswerSheet)
// understands the new semantics yet — left untouched until that application
// code is written alongside it, not as a bare schema change.

enum AssessmentKind {
  COACHING_TEST
  SCHOOL_THEORY_EXAM
  PRACTICE_TEST
  DIAGNOSTIC
  HOMEWORK_GRADED
}

enum StakesLevel {
  GRADED
  PRACTICE
  DIAGNOSTIC_ONLY
}

enum EvaluationPolicyMode {
  AUTOMATIC
  MANUAL_ONLY
  AI_ASSIST_MANDATORY_REVIEW
  AI_FINAL_LOW_STAKES
}

enum EvidenceType {
  DIGITAL_VALUE
  OMR_MARK
  PAGE_REGION
}

enum CaptureProviderType {
  OMR
  MANUAL_GRID
  CSV_IMPORT
  PHOTO_CAPTURE_OBJECTIVE
  PHOTO_CAPTURE_SUBJECTIVE
}

enum DocumentBundleStatus {
  UPLOADING
  PROCESSING
  PARTIALLY_RESOLVED
  COMPLETE
  FAILED
}

enum DocumentStatus {
  UPLOADED
  PAGE_PROCESSING
  IDENTITY_PENDING
  REGION_MAPPING
  READY_FOR_EVALUATION
  FAILED
}

enum DocumentLayoutType {
  TEMPLATE_KNOWN
  FREE_FORM
}

enum PageStatus {
  PENDING
  PROCESSED
  FLAGGED
}

enum RegionType {
  QUESTION_ANSWER
  HEADER
  MARGIN
  ROLL_NUMBER_FIELD
  SIGNATURE
  UNCLASSIFIED
}

enum DetectionMethod {
  AUTO_LAYOUT_DETECTION
  MANUAL_TEACHER_MARKUP
  TEMPLATE_MATCHED
}

enum OCRBlockType {
  PRINTED_TEXT
  HANDWRITTEN_TEXT
  MATHEMATICAL_EXPRESSION
  DIAGRAM_SKETCH
  TABLE
}

enum ProcessingStage {
  VALIDATE
  DESKEW
  PAGE_ORDER
  IDENTITY_RESOLVE
  REGION_DETECT
  LAYOUT_ANALYSIS
  OCR
  QUESTION_MAP
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AnnotationType {
  CIRCLE
  TICK
  CROSS
  COMMENT
}

enum IdentityMethod {
  BARCODE
  ROLL_NUMBER_OCR
  QR_CODE
  MANUAL_ADMIN_MATCH
}

enum IdentityStatus {
  PENDING
  AUTO_RESOLVED
  MANUALLY_CONFIRMED
  MANUALLY_CORRECTED
  UNRESOLVED
  // Phase 10 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md) addition — 30-IDENTITY-
  // PAGE-MAPPING.md §5 describes "flagged CONFLICT" behavior for two Documents
  // resolving to the same studentProfileId+delivery, but the doc's own §2
  // entity table (and this schema, until now) never actually defined a
  // CONFLICT status value to hold that state in.
  CONFLICT
}

enum RubricScoringMode {
  CRITERION_ADDITIVE
  STEP_WISE
  HOLISTIC_WITH_GUIDANCE
}

enum EvaluationStatus {
  PENDING
  AI_SUGGESTED
  TEACHER_REVIEWED
  REVIEWER_FINALIZED
}

enum EvaluationSource {
  AI
  TEACHER
  REVIEWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  DUPLICATE
  UNDER_EVALUATION
  FINALIZED
}

enum AIModelPurpose {
  EVALUATION
  OCR
  HANDWRITING
  BLUEPRINT
}

// ---------------------------------------------------------------------------
// V2: ASSESSMENT ENGINE
// ---------------------------------------------------------------------------

model Assessment {
  id              String         @id @default(cuid())
  instituteId     String
  title           String
  assessmentKind  AssessmentKind
  stakesLevel     StakesLevel
  subjectIds      String[]
  paperId         String?
  totalMarks      Float
  gradeLevel      String?
  createdByUserId String
  createdAt       DateTime       @default(now())

  institute  Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  paper      Paper?               @relation(fields: [paperId], references: [id])
  deliveries AssessmentDelivery[]

  @@index([instituteId])
  @@map("assessments")
}

model EvaluationPolicy {
  id                  String               @id @default(cuid())
  instituteId         String
  name                String
  mode                EvaluationPolicyMode
  requiresHumanReview Boolean
  createdAt           DateTime             @default(now())

  institute  Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  deliveries AssessmentDelivery[]

  @@map("evaluation_policies")
}

model AssessmentDelivery {
  id                 String      @id @default(cuid())
  assessmentId       String
  batchId            String
  status             ExamStatus  @default(DRAFT) // unchanged 7-state values from v1 Exam.status, per doc
  version             Int        @default(0)
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  captureProviderId  String
  evaluationPolicyId String
  unlockReason       String?
  createdByUserId    String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  assessment       Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  batch            Batch            @relation(fields: [batchId], references: [id])
  captureProvider  CaptureProvider  @relation(fields: [captureProviderId], references: [id])
  evaluationPolicy EvaluationPolicy @relation(fields: [evaluationPolicyId], references: [id])
  attempts         Attempt[]
  documentBundles  DocumentBundle[]
  exam             Exam?
  copyCheckerAssignments CopyCheckerAssignment[]
  bookletPrintRuns       BookletPrintRun[]
  booklets               Booklet[]

  @@index([status])
  @@index([assessmentId])
  @@map("assessment_deliveries")
}

model Attempt {
  id                   String       @id @default(cuid())
  assessmentDeliveryId String
  studentProfileId     String
  rollNumberSnapshot   String?      // Preserves historical roll number at the exact time of assessment
  status               AttemptStatus @default(IN_PROGRESS)
  isActiveAttempt      Boolean      @default(true)
  submittedAt          DateTime?
  createdAt            DateTime     @default(now())

  assessmentDelivery AssessmentDelivery @relation(fields: [assessmentDeliveryId], references: [id], onDelete: Cascade)
  studentProfile     StudentProfile     @relation(fields: [studentProfileId], references: [id])
  documents          Document[]
  responses          Response[]
  scoreRecord        ScoreRecord?

  @@unique([assessmentDeliveryId, studentProfileId, isActiveAttempt])
  @@index([assessmentDeliveryId, studentProfileId])
  @@map("attempts")
}

model CaptureProvider {
  id          String              @id @default(cuid())
  instituteId String
  type        CaptureProviderType
  config      Json
  createdAt   DateTime            @default(now())

  institute  Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  deliveries AssessmentDelivery[]

  @@map("capture_providers")
}

// ---------------------------------------------------------------------------
// V2: DOCUMENT PROCESSING PIPELINE
// ---------------------------------------------------------------------------

model DocumentBundle {
  id                     String               @id @default(cuid())
  assessmentDeliveryId   String
  uploadedByUserId       String
  expectedDocumentCount  Int?
  status                 DocumentBundleStatus @default(UPLOADING)
  createdAt              DateTime             @default(now())

  assessmentDelivery AssessmentDelivery @relation(fields: [assessmentDeliveryId], references: [id], onDelete: Cascade)
  documents          Document[]

  @@map("document_bundles")
}

model Document {
  id                String             @id @default(cuid())
  documentBundleId  String?
  attemptId         String?            // populated only once IdentityResolution confirms/creates the link — see fix #7 note above
  expectedPageCount Int?
  layoutType        DocumentLayoutType @default(TEMPLATE_KNOWN)
  status            DocumentStatus     @default(UPLOADED)
  bookletSerial     String?            // Resolved physical booklet serial if scanned from serialized cover
  // Set when the booklet arrived as a PDF: the storage key of the ORIGINAL
  // upload, kept alongside the page images rendered from it so a re-render is
  // possible without asking the teacher to upload again. Null for image uploads.
  sourceFileKey     String?
  createdAt         DateTime           @default(now())

  documentBundle    DocumentBundle?    @relation(fields: [documentBundleId], references: [id])
  attempt           Attempt?           @relation(fields: [attemptId], references: [id])
  pages             Page[]
  processingJobs    ProcessingJob[]
  identityResolution IdentityResolution?

  @@index([documentBundleId, status])
  @@index([attemptId])
  @@map("documents")
}

model Page {
  id         String     @id @default(cuid())
  documentId String
  pageNumber Int
  status     PageStatus @default(PENDING)

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  images   PageImage[]

  @@unique([documentId, pageNumber])
  @@map("pages")
}

model PageImage {
  id                String   @id @default(cuid())
  pageId            String
  rawImageUrl       String
  processedImageUrl String?
  deskewAngle       Float?
  qualityScore      Float?
  createdAt         DateTime @default(now())

  page        Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  regions     PageRegion[]
  annotations Annotation[]

  @@map("page_images")
}

/// Also serves as "QuestionRegion" when questionId is non-null (23-DOCUMENT-PROCESSING-ARCHITECTURE.md).
model PageRegion {
  id                  String         @id @default(cuid())
  pageImageId         String
  boundingBox         Json
  regionType          RegionType
  questionId          String?
  detectionMethod     DetectionMethod
  detectionConfidence Float?
  createdAt           DateTime       @default(now())

  pageImage PageImage  @relation(fields: [pageImageId], references: [id], onDelete: Cascade)
  ocrBlocks OCRBlock[]
  // Phase 10 addition — the evidence-pointer traceability doc 04 §5's
  // constraints summary describes ("Response.evidenceType determines which of
  // digitalValue/questionRegionId must be non-null") but Phase 7/8 never
  // actually added, since Phase 8 didn't yet need PAGE_REGION evidence.
  responses Response[]

  @@map("page_regions")
}

model OCRBlock {
  id               String       @id @default(cuid())
  questionRegionId String
  blockType        OCRBlockType
  boundingBox      Json

  questionRegion PageRegion @relation(fields: [questionRegionId], references: [id], onDelete: Cascade)
  results        OCRResult[]

  @@map("ocr_blocks")
}

model OCRResult {
  id                  String    @id @default(cuid())
  ocrBlockId          String
  extractedText       String?
  confidence          Float
  alternativeReadings Json?
  aiModelVersionId    String
  processedAt         DateTime  @default(now())
  // Phase 11 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md) addition — 24-OCR-
  // HANDWRITING-ARCHITECTURE.md §3.3 describes a "requires_visual_evaluation:
  // true" flag for DIAGRAM_SKETCH/TABLE blocks (no text extraction attempted)
  // but never defines where that flag structurally lives. A real schema gap,
  // same class as Phase 10's IdentityStatus.CONFLICT finding.
  requiresVisualEvaluation Boolean @default(false)

  ocrBlock      OCRBlock      @relation(fields: [ocrBlockId], references: [id], onDelete: Cascade)
  aiModelVersion AIModelVersion @relation(fields: [aiModelVersionId], references: [id])

  @@map("ocr_results")
}

model ProcessingJob {
  id          String              @id @default(cuid())
  documentId  String
  stage       ProcessingStage
  status      ProcessingJobStatus @default(QUEUED)
  attemptCount Int                @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  // Why a stage failed, in words a teacher can act on ("this PDF is password-
  // protected"). Set by the pdf-split worker; null for everything else.
  errorMessage String?

  document  Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  artifacts ProcessingArtifact[]

  @@index([documentId, stage, status])
  @@map("processing_jobs")
}

model ProcessingArtifact {
  id              String   @id @default(cuid())
  processingJobId String
  artifactType    String
  data            Json
  createdAt       DateTime @default(now())

  processingJob ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)

  @@map("processing_artifacts")
}

model Annotation {
  id             String         @id @default(cuid())
  pageImageId    String
  authorUserId   String
  boundingBox    Json?
  annotationType AnnotationType
  text           String?
  createdAt      DateTime       @default(now())

  pageImage PageImage @relation(fields: [pageImageId], references: [id], onDelete: Cascade)

  @@map("annotations")
}

model IdentityResolution {
  id                        String         @id @default(cuid())
  documentId                String         @unique
  method                    IdentityMethod
  candidateStudentProfileId String?
  confidence                Float
  resolvedStudentProfileId  String?
  resolvedByUserId          String?
  status                    IdentityStatus @default(PENDING)
  createdAt                 DateTime       @default(now())
  resolvedAt                DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("identity_resolutions")
}

// ---------------------------------------------------------------------------
// V2: RUBRIC ENGINE
// ---------------------------------------------------------------------------

model Rubric {
  id              String            @id @default(cuid())
  instituteId     String
  questionId      String            @unique
  name            String
  maxMarks        Float
  scoringMode     RubricScoringMode
  createdByUserId String
  createdAt       DateTime          @default(now())

  institute Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  question  Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  versions  RubricVersion[]

  @@map("rubrics")
}

model RubricVersion {
  id              String   @id @default(cuid())
  rubricId        String
  versionNumber   Int
  criteriaSnapshot Json
  editedByUserId  String
  createdAt       DateTime @default(now())

  rubric     Rubric             @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]

  @@unique([rubricId, versionNumber])
  @@map("rubric_versions")
}

model RubricCriterion {
  id                   String   @id @default(cuid())
  rubricVersionId      String
  order                Int
  description          String
  maxMarks             Float
  keywordHints         String[]
  dependsOnCriterionId String?

  rubricVersion RubricVersion     @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)
  dependsOn     RubricCriterion?  @relation("CriterionDependency", fields: [dependsOnCriterionId], references: [id])
  dependents    RubricCriterion[] @relation("CriterionDependency")
  criterionScores EvaluationCriterionScore[]

  @@map("rubric_criteria")
}

// ---------------------------------------------------------------------------
// V2: EVALUATION ENGINE
// ---------------------------------------------------------------------------
// responseId below FKs into the existing v1 Response table — see the bridging
// decision noted at the top of this V2 block.

model Evaluation {
  id                        String           @id @default(cuid())
  responseId                String           @unique
  currentEvaluationVersionId String?         @unique
  status                    EvaluationStatus @default(PENDING)

  response       Response          @relation(fields: [responseId], references: [id], onDelete: Cascade)
  currentVersion EvaluationVersion? @relation("CurrentEvaluationVersion", fields: [currentEvaluationVersionId], references: [id])
  versions       EvaluationVersion[] @relation("EvaluationVersions")

  @@map("evaluations")
}

model EvaluationVersion {
  id                 String           @id @default(cuid())
  evaluationId       String
  previousVersionId  String?
  source             EvaluationSource
  authorUserId       String?
  marksAwarded       Float
  mistakeTagType     MistakeTagType?
  teacherComment     String?
  aiRecommendationId String?
  disputeReason      String?
  // Tag-wise marks as the author of this version saw/edited them:
  // { verdict, mistakeTag, tags: [{ tag, maxMarks, marksAwarded, note }], note,
  //   modelSolution?, referenceUsed? }. Nullable — versions written before
  // tag-wise marking, and manual decisions made without one, have none.
  gradingBreakdown   Json?
  createdAt          DateTime         @default(now())

  evaluation      Evaluation                 @relation("EvaluationVersions", fields: [evaluationId], references: [id], onDelete: Cascade)
  previousVersion EvaluationVersion?         @relation("EvaluationVersionChain", fields: [previousVersionId], references: [id])
  nextVersions    EvaluationVersion[]        @relation("EvaluationVersionChain")
  currentOfEvaluation Evaluation?            @relation("CurrentEvaluationVersion")
  criterionScores EvaluationCriterionScore[]
  // Phase 13 (docs/33-GAP-ANALYSIS-AND-BUILD-PLAN.md) addition — aiRecommendationId
  // was a bare column with no @relation since Phase 7; Phase 13 needs a real join
  // from an AI-sourced EvaluationVersion back to its AIRecommendation (e.g. to read
  // .flags for GET /evaluation-work-items's aiFlag filter).
  aiRecommendation AIRecommendation? @relation(fields: [aiRecommendationId], references: [id])

  @@index([evaluationId, createdAt])
  @@map("evaluation_versions")
}

model EvaluationCriterionScore {
  id                  String  @id @default(cuid())
  evaluationVersionId String
  rubricCriterionId   String
  marksAwarded        Float
  note                String?

  evaluationVersion EvaluationVersion @relation(fields: [evaluationVersionId], references: [id], onDelete: Cascade)
  rubricCriterion   RubricCriterion   @relation(fields: [rubricCriterionId], references: [id])

  @@map("evaluation_criterion_scores")
}

model AIRecommendation {
  id                  String   @id @default(cuid())
  responseId          String
  questionVersionId   String
  rubricVersionId     String?
  evidenceRef         Json
  ocrResultId         String?
  evaluationPolicyId  String
  aiModelVersionId    String
  promptVersionId     String
  modelParameters     Json
  inputArtifactHash   String
  suggestedMarks      Float
  suggestedCriterionScores Json?
  confidence          Float
  flags               String[]
  // The model's tag-wise split, verdict, mistake type and — when the question
  // had no reference answer — its own model solution. Same shape as
  // EvaluationVersion.gradingBreakdown.
  gradingBreakdown    Json?
  createdAt           DateTime @default(now())

  response        Response        @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])
  aiModelVersion  AIModelVersion  @relation(fields: [aiModelVersionId], references: [id])
  promptVersion   PromptVersion   @relation(fields: [promptVersionId], references: [id])
  evaluationVersions EvaluationVersion[]

  @@index([responseId, createdAt])
  @@index([aiModelVersionId])
  @@index([promptVersionId])
  @@index([questionVersionId, rubricVersionId])
  @@map("ai_recommendations")
}

// ---------------------------------------------------------------------------
// V2: AI MODEL REGISTRY (fix #6 — no evaluation-domain code may hardcode a
// vendor SDK call; every AI invocation resolves through these tables)
// ---------------------------------------------------------------------------

model AIProvider {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  aiModels AIModel[]

  @@map("ai_providers")
}

model AIModel {
  id           String          @id @default(cuid())
  aiProviderId String
  name         String
  purpose      AIModelPurpose
  createdAt    DateTime        @default(now())

  provider AIProvider      @relation(fields: [aiProviderId], references: [id], onDelete: Cascade)
  versions AIModelVersion[]
  prompts  PromptVersion[]

  @@map("ai_models")
}

model AIModelVersion {
  id            String    @id @default(cuid())
  aiModelId     String
  versionLabel  String
  isActive      Boolean   @default(true)
  deprecatedAt  DateTime?
  createdAt     DateTime  @default(now())

  model             AIModel            @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  ocrResults        OCRResult[]
  aiRecommendations AIRecommendation[]

  @@index([aiModelId, isActive])
  @@map("ai_model_versions")
}

model PromptVersion {
  id              String   @id @default(cuid())
  aiModelId       String
  versionLabel    String
  promptTemplate  String
  createdByUserId String
  createdAt       DateTime @default(now())

  model             AIModel            @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  aiRecommendations AIRecommendation[]

  @@map("prompt_versions")
}

// ---------------------------------------------------------------------------
// V2: BATCH ENROLLMENT & HISTORICAL STUDENT ACADEMIC IDENTITY
// ---------------------------------------------------------------------------

model BatchEnrollment {
  id               String           @id @default(cuid())
  instituteId      String
  batchId          String
  studentProfileId String
  rollNumber       String?
  academicYear     String?
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now())
  transferredAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  institute      Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch          Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentProfileId])
  @@unique([batchId, rollNumber])
  @@index([instituteId, status])
  @@index([studentProfileId])
  @@map("batch_enrollments")
}

// ---------------------------------------------------------------------------
// V2: COPY CHECKER ASSIGNMENTS & EVALUATION AUTHORIZATION ENGINE
// ---------------------------------------------------------------------------

model CopyCheckerAssignment {
  id                   String          @id @default(cuid())
  instituteId          String
  assessmentDeliveryId String
  teacherProfileId     String
  scope                AssignmentScope @default(BATCH)
  isLeadEvaluator      Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  assessmentDelivery AssessmentDelivery @relation(fields: [assessmentDeliveryId], references: [id], onDelete: Cascade)
  teacherProfile     TeacherProfile     @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  studentAllocations CopyCheckerStudentAllocation[]
  questionAllocations CopyCheckerQuestionAllocation[]

  @@unique([assessmentDeliveryId, teacherProfileId])
  @@unique([id, assessmentDeliveryId])
  @@index([instituteId])
  @@index([teacherProfileId])
  @@map("copy_checker_assignments")
}

model CopyCheckerStudentAllocation {
  id                      String                @id @default(cuid())
  copyCheckerAssignmentId String
  assessmentDeliveryId    String
  studentProfileId        String
  createdAt               DateTime              @default(now())

  assignment     CopyCheckerAssignment @relation(fields: [copyCheckerAssignmentId, assessmentDeliveryId], references: [id, assessmentDeliveryId], onDelete: Cascade)
  studentProfile StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([assessmentDeliveryId, studentProfileId])
  @@index([copyCheckerAssignmentId])
  @@map("copy_checker_student_allocations")
}

model CopyCheckerQuestionAllocation {
  id                      String                @id @default(cuid())
  copyCheckerAssignmentId String
  assessmentDeliveryId    String
  questionId              String
  createdAt               DateTime              @default(now())

  assignment CopyCheckerAssignment @relation(fields: [copyCheckerAssignmentId, assessmentDeliveryId], references: [id, assessmentDeliveryId], onDelete: Cascade)
  question   Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentDeliveryId, questionId])
  @@index([copyCheckerAssignmentId])
  @@map("copy_checker_question_allocations")
}

// ---------------------------------------------------------------------------
// V2: PHYSICAL BOOKLET & PRINT-RUN LIFECYCLE
// ---------------------------------------------------------------------------

model BookletPrintRun {
  id                   String         @id @default(cuid())
  instituteId          String
  assessmentDeliveryId String
  count                Int
  startSerial          Int
  endSerial            Int
  status               PrintRunStatus @default(PENDING)
  pdfStorageKey        String?
  signingKeyId         String
  generatedByUserId    String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  assessmentDelivery AssessmentDelivery @relation(fields: [assessmentDeliveryId], references: [id], onDelete: Cascade)
  booklets           Booklet[]

  @@index([instituteId, assessmentDeliveryId])
  @@map("booklet_print_runs")
}

model Booklet {
  id                   String        @id @default(cuid())
  instituteId          String
  assessmentDeliveryId String
  printRunId           String
  bookletSerial        String
  numericSerial        Int
  status               BookletStatus @default(GENERATED)
  voidReason           String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  printRun           BookletPrintRun    @relation(fields: [printRunId], references: [id], onDelete: Cascade)
  assessmentDelivery AssessmentDelivery @relation(fields: [assessmentDeliveryId], references: [id], onDelete: Cascade)

  @@unique([assessmentDeliveryId, bookletSerial])
  @@unique([assessmentDeliveryId, numericSerial])
  @@index([instituteId, assessmentDeliveryId])
  @@map("booklets")
}
