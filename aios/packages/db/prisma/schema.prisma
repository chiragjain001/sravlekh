// This is the AIOS Prisma schema — the single source of truth for all database tables.
// LOCKED: Do not add, remove, or rename tables without updating the Technical Architecture document.

generator client {
  provider = "prisma-client-js"
}

generator client_py {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

