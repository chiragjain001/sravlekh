{
  "name": "@aios/db",
  "version": "0.1.0",
  "private": true,
  "description": "AIOS Prisma schema, client, and migrations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx --env-file .env src/seed.ts",
    "seed:demo-school": "tsx --env-file .env src/seed-demo-school.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.17.0"
  },
  "devDependencies": {
    "prisma": "5.17.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "@aios/config": "workspace:*",
    "@types/node": "^20.14.2"
  },
  "prisma": {
    "seed": "tsx --env-file .env src/seed.ts"
  }
}
