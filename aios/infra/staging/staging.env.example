# Staging smoke-test environment — TEMPLATE. Copy, fill in, never commit.
#
#   cp infra/staging/staging.env.example infra/staging/staging.env
#
# infra/staging/staging.env is gitignored. Put the real key there and nowhere
# else: never on the command line (it lands in shell history and the process
# list), never in staging.env.example, never in a commit.

# Must be exactly "staging" or the smoke test refuses to run.
AIOS_ENV=staging

# Matches infra/staging/docker-compose.yml. Throwaway credentials for a local,
# empty, loopback-only database.
DATABASE_URL=postgresql://aios_staging:staging_local_only@localhost:5433/aios_staging

# The databases this smoke test is permitted to touch, as comma-separated
# host:port entries. There is no default — unset means nothing is nominated, so
# nothing is permitted, and the run fails closed.
#
# Nominate ONLY disposable staging databases. Never add a shared or hosted
# instance: checks 8 and 9 create and delete rows.
STAGING_DB_ALLOWLIST=localhost:5433

# Any 32+ character throwaway value. Required for the Settings object to
# construct; the smoke test never issues or verifies a token.
JWT_SECRET=staging-only-not-a-real-secret-32-chars-min

# REQUIRED — a staging-scoped provider key with a low spend cap.
# Never a production key. The script prints its length, never its value.
OPENAI_API_KEY=

# REQUIRED for check 2 (OCR multimodal). A publicly reachable image of legible
# printed text — the provider fetches this itself, so localhost and private
# hosts will not work.
#
# MUST be synthetic or consented material. Never a real student's answer sheet:
# that sends personal data to a third party outside the normal evaluation flow,
# with no offsetting benefit.
SMOKE_OCR_IMAGE_URL=

# Optional model overrides. Defaults to gpt-4o for both.
# SMOKE_EVAL_MODEL=gpt-4o
# SMOKE_OCR_MODEL=gpt-4o
