NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server-side only (never sent to the browser): where the Python AI/analytics
# engine listens. Proxied to via the /api/py rewrite in next.config.js, so the
# engine does not need to be publicly reachable or CORS-configured for the
# browser origin.
PYTHON_API_URL=http://localhost:8000
