# ──────────────────────────────────────────────
# AIOS API — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000

# DEV ONLY — enables POST /auth/dev-login, which mints a real JWT for any
# requested role with NO credentials. Leave unset/false everywhere except a
# local dev machine. Setting this to true while NODE_ENV=production makes the
# API refuse to start (see src/config/env.schema.ts). Never set it in staging
# or production, and never in a shared environment reachable from the internet.
ENABLE_DEV_LOGIN=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aios_dev

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT (must be at least 32 characters — use: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File storage (AWS S3 or Supabase Storage)
# S3_BUCKET=aios-dev-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# Background jobs (Redis for BullMQ)
# REDIS_URL=redis://localhost:6379

# AI (OpenAI)
# OPENAI_API_KEY=sk-...

# Internal NestJS -> FastAPI service contract (02-SYSTEM-ARCHITECTURE.md)
PYTHON_SERVICE_URL=http://localhost:8000
# INTERNAL_SERVICE_TOKEN=change-this-shared-secret-must-match-apps-api-python-env
# ^ Must match apps/api-python's INTERNAL_SERVICE_TOKEN EXACTLY — the Node API and
#   the worker send it, the Python service checks it.
#
#   REQUIRED IN PRODUCTION, minimum 32 characters. Both services refuse to start
#   without it when NODE_ENV=production (env.schema.ts / config.py). Unset, the
#   Python AI endpoints authenticate nobody: they take no user JWT by design, so
#   this is the only thing guarding them.
#
#   Generate a distinct value PER ENVIRONMENT — never reuse the staging token in
#   production. A leaked staging token must not grant production access:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   Store it in the platform's secret manager. Never commit it; the filled-in
#   .env files are gitignored.

# Monitoring
# SENTRY_DSN=https://...

# Notifications
# SENDGRID_API_KEY=
# WHATSAPP_API_TOKEN=
# SMS_GATEWAY_KEY=
