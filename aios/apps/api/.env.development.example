# ──────────────────────────────────────────────
# AIOS API — Development Environment Example
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ENABLE_DEV_LOGIN=true

# Database (Local PostgreSQL Docker or Dev DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aios_dev
DATABASE_POOL_LIMIT=10

# Security / Sessions
JWT_SECRET=development-only-insecure-secret-32-chars-long!
JWT_EXPIRES_IN=7d

# Google OAuth (optional for local mock dev)
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Redis Cache / Queue
REDIS_URL=redis://localhost:6379

# Internal Python Service
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-32-chars-long!
