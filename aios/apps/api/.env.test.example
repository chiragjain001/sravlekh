# ──────────────────────────────────────────────
# AIOS API — Test / CI Environment Example
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4001
ENABLE_DEV_LOGIN=true

# Database (Isolated Test DB - reset per test run)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aios_test
DATABASE_POOL_LIMIT=5

# Security / Sessions
JWT_SECRET=test-environment-jwt-secret-min-32-characters-ok!
JWT_EXPIRES_IN=1h

# Google OAuth mock
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Redis Cache / Queue (Isolated DB index or dedicated container)
REDIS_URL=redis://localhost:6379/1

# Internal Python Service
PYTHON_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_TOKEN=test-internal-token-must-be-at-least-32-chars!
