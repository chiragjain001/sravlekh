{
  "name": "@aios/api",
  "version": "0.1.0",
  "private": true,
  "description": "AIOS NestJS API server",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --maxWorkers=2 --ci"
  },
  "dependencies": {
    "@aios/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.632.0",
    "@aws-sdk/s3-request-presigner": "^3.632.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.17.0",
    "@sentry/node": "^10.70.0",
    "axios": "^1.7.2",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "5.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
