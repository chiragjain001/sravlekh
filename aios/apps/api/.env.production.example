# ──────────────────────────────────────────────
# AIOS API — Production Environment Template
# ──────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# HARD SECURITY INVARIANT: Must be false or absent in production!
# API startup validation will refuse to boot if set to true.
ENABLE_DEV_LOGIN=false

# Production Database (Supabase Mumbai / AWS RDS Mumbai pooler URL)
# Validation will refuse to boot if pointing to localhost or a database named '*test*' / '*dev*'
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_POOL_LIMIT=15

# Security / Sessions (Rotate regularly via KMS / AWS Secrets Manager)
# Must be at least 32 cryptographically secure characters: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_32_CHAR_PRODUCTION_SECRET
JWT_EXPIRES_IN=15m

# Google OAuth Credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_SECRET

# Frontend Production Domain
FRONTEND_URL=https://app.sarvlekh.com

# Production Cloudflare R2 / S3 Storage
S3_BUCKET=sarvlekh-prod-assets
AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
AWS_REGION=auto

# Redis (Production Redis 7 container on host loopback or VPC Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Internal Service-to-Service Contract
# Refuses to boot if unset or < 32 characters in production
PYTHON_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_STRONG_32_CHAR_INTERNAL_SERVICE_TOKEN

# Monitoring (Optional)
SENTRY_DSN=https://your-dsn@sentry.io/project
