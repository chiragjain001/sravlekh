# ──────────────────────────────────────────────
# AIOS AI/Analytics Engine — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────

# Database (PostgreSQL) — same instance as apps/api
DATABASE_URL=postgresql://postgres:password@localhost:5432/aios_dev

# JWT — must match apps/api's JWT_SECRET exactly (this service verifies the same tokens)
JWT_SECRET=change-this-to-a-secret-at-least-32-characters-long

# AI (OpenAI, used by the Blueprint Agent)
# OPENAI_API_KEY=sk-...

# AI (Gemini) — dev-only fallback the Blueprint Agent uses when OPENAI_API_KEY
# is not set. Get a key at https://aistudio.google.com/apikey. Ignored entirely
# when OPENAI_API_KEY is set.
# GEMINI_API_KEY=...

# Internal NestJS -> FastAPI service contract (02-SYSTEM-ARCHITECTURE.md)
# Must match apps/api's INTERNAL_SERVICE_TOKEN exactly. Unset means unenforced
# (dev-only fallback) — never leave unset in production.
# INTERNAL_SERVICE_TOKEN=change-this-shared-secret-must-match-apps-api-env
