# ─────────────────────────────────────────────────────────────────────────────
# AIOS / SARVLEKH — Production Environment Variables Template (.env.production)
# Target Architecture: AWS Lightsail 4GB Host + Supabase Managed PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
AIOS_ENV=production

# ── Reverse Proxy & IP Resolution (Task 1) ───────────────────────────────────
# Explicit proxy trust configuration for Fastify.
# In Docker bridge deployments, trust the bridge subnet and loopback: "172.28.0.0/16,127.0.0.1".
# For host-only Nginx, use 'loopback' or '127.0.0.1'.
# Wildcard ('true') is strictly rejected at startup in production.
TRUST_PROXY=172.28.0.0/16,127.0.0.1

# ── Database (Task 3: Supabase PgBouncer & Direct URL) ───────────────────────
# Primary runtime database connection via Supabase Transaction Pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Dedicated direct PostgreSQL connection (port 5432) used ONLY by Prisma migrations.
# Required because migrations use session locks not supported by PgBouncer transaction mode.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Connection pool sizing per container process
# API (15) + Worker (10) = 25 total connections (well within Supabase PgBouncer pool ceiling).
DATABASE_POOL_LIMIT=15
DATABASE_POOL_TIMEOUT=20

# ── Session & Authentication Security ─────────────────────────────────────────
# Generate with: openssl rand -base64 48 (minimum 32 characters)
JWT_SECRET=generate-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m

# DEV-ONLY login MUST be false in production (enforced by startup validator)
ENABLE_DEV_LOGIN=false

# ── Frontend & CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://aios.your-institute.com
PUBLIC_API_URL=https://aios.your-institute.com

# ── Google OAuth Credentials (for Student/Teacher Single Sign-On) ─────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Redis Cache & Queue Broker (BullMQ) ──────────────────────────────────────
# In Docker Compose bridge deployment, use the Redis container IP (172.28.0.11:6379)
REDIS_URL=redis://172.28.0.11:6379

# ── Background Worker Concurrency Caps (Task 4: Low-Memory Tuning) ───────────
# Bounded to prevent CPU and RAM starvation on 4GB host
QUEUE_CONCURRENCY_OCR=1
QUEUE_CONCURRENCY_PDF_SPLIT=1
QUEUE_CONCURRENCY_AI_EVALUATION=2
QUEUE_CONCURRENCY_SCORE_AGGREGATION=3
QUEUE_CONCURRENCY_MASTERY_RECALC=3
MAX_CONCURRENT_UPLOADS=3

# ── S3 / Cloudflare R2 Object Storage (Single Shared Production Bucket) ──────
# All institutes share a single private bucket; multi-tenancy is enforced by
# tenant key prefixes: 'institutes/{instituteId}/...' and 'pending/institutes/{instituteId}/...'
S3_BUCKET=aios-production-storage-mumbai
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Optional: Dedicated off-site backup bucket for daily encrypted database snapshots
# BACKUP_S3_BUCKET=aios-production-backups-mumbai

# ── Cryptographic QR Signing for Examination Booklets (07-SECURITY-SPECIFICATION.md) ─
# Generate with: openssl rand -base64 32 (minimum 32 characters)
BOOKLET_QR_SIGNING_KEY=your-cryptographic-qr-hmac-key-at-least-32-chars

# ── Internal Service Token (NestJS API <-> Python FastAPI) ────────────────────
# Enforces mutual authentication on internal service calls
INTERNAL_SERVICE_TOKEN=your-random-internal-service-token-at-least-32-chars
# In Docker Compose bridge deployment, use the Python container IP (172.28.0.14:8000)
PYTHON_SERVICE_URL=http://172.28.0.14:8000

# ── AI Provider Tokens (Optional: Required only if AI Copy Checking is active) ─
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# ── Operational & Monitoring ──────────────────────────────────────────────────
SHUTDOWN_DRAIN_MS=5000
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

