# AIOS Monorepo
node_modules/
.env
.env.local
.env.*.local
# Staging smoke-test secrets. The template (staging.env.example) IS tracked;
# the filled-in file holding a real provider key must never be. Note that the
# bare `.env` rule above does NOT match `staging.env`.
infra/staging/staging.env
.next/
dist/
build/
*.tsbuildinfo
.turbo/
.pnpm-store/
coverage/
*.log
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
.venv-ci/

# Development-only file storage fallback (StorageService), never committed
.local-storage/

# Database backups. These contain REAL DATA — every row of whatever database
# they were taken from, including user emails and any PII. They are never
# committed, and the tooling writes them here by default so that a routine
# `git add -A` cannot sweep one in.
infra/backup/artifacts/
